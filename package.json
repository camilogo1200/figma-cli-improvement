{
  "name": "figma-cli-ultimate",
  "version": "3.0.0",
  "description": "Multi-agent bridge for Figma Desktop: one private highway per agent, turn-taking, scoped recovery and a live worker console.",
  "author": "Cristhian Camilo Gómez Narváez",
  "contributors": [
    {
      "name": "Sil Bormüller",
      "url": "https://www.silbormueller.com/"
    }
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "figma-ultimate": "bin/figma-ultimate.mjs",
    "figma-cli-ultimate": "bin/figma-ultimate.mjs"
  },
  "exports": {
    ".": "./file-client.mjs",
    "./client": "./bridge/fig.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "cli",
    "bridge",
    "plugin",
    "src",
    "file-client.mjs"
  ],
  "keywords": [
    "figma",
    "figma-plugin",
    "ai-agents",
    "automation",
    "bridge",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camilogo1200/figma-cli-improvement.git"
  },
  "homepage": "https://github.com/camilogo1200/figma-cli-improvement#readme",
  "bugs": {
    "url": "https://github.com/camilogo1200/figma-cli-improvement/issues"
  },
  "scripts": {
    "setup": "node bin/figma-ultimate.mjs setup",
    "test": "node bin/figma-ultimate.mjs build && node --test tests/*.test.js",
    "test:live": "node tests/live/navigation-stress.mjs --plan --mode all",
    "docs": "node docs/render.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  }
}
